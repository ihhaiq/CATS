BOT_TOKEN=

# json is convenient locally; use postgres on Railway.
STORAGE_BACKEND=json
DATABASE_URL=
JSON_DATA_FILE=data/catibot.json

# Empty means local long polling. Set the public Railway URL for webhooks.
WEBHOOK_BASE_URL=
WEBHOOK_PATH=/webhook

ADMIN_IDS=
NOTIFICATION_INTERVAL_MINUTES=15

# Optional Telegram file_ids. /dev can upload breed-specific media instead.
STATUS_MEDIA_FILE_ID=
FEED_MEDIA_FILE_ID=
PLAY_MEDIA_FILE_ID=
WALK_MEDIA_FILE_ID=
TALK_MEDIA_FILE_ID=
SLEEP_MEDIA_FILE_ID=
CAT_ANGRY_SLEEP_MEDIA_FILE_ID=
