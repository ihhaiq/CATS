BOT_TOKEN=

# json is convenient locally; use postgres on Railway.
STORAGE_BACKEND=json
DATABASE_URL=
JSON_DATA_FILE=data/catibot.json

# Empty means local long polling. Set the public Railway URL for webhooks.
WEBHOOK_BASE_URL=
WEBHOOK_PATH=/webhook
PORT=8080

ADMIN_IDS=
NOTIFICATION_INTERVAL_MINUTES=15

# Optional Telegram file_ids. /dev can upload breed-specific media instead.
STATUS_MEDIA_FILE_ID=
FEED_MEDIA_FILE_ID=
PLAY_MEDIA_FILE_ID=
WALK_MEDIA_FILE_ID=
TALK_MEDIA_FILE_ID=
SLEEP_MEDIA_FILE_ID=
CAT_ANGRY_SLEEP_MEDIA_FILE_ID=


# Rest meter: drops 1% every 5 minutes while the cat is awake.
SLEEP_DECAY_INTERVAL_MINUTES=5
SLEEP_DECAY_AMOUNT=1

# Optional: chat/channel used for silent lazy asset uploads. If omitted,
# Catibot temporarily uploads to the current user/chat and deletes the message.
MEDIA_CACHE_CHAT_ID=
