BOT_TOKEN=

# The active gameplay repository is still JSON-backed.
# Keep DATABASE_URL configured on Railway; PostgreSQL schema support is retained
# for the migration to SQL.
STORAGE_BACKEND=json
DATABASE_URL=
JSON_DATA_FILE=data/catibot.json

# Empty means local long polling. Set the public Railway URL for webhooks.
WEBHOOK_BASE_URL=
WEBHOOK_PATH=/webhook
PORT=8080

ADMIN_IDS=
NOTIFICATION_INTERVAL_MINUTES=15

# Optional Telegram file_ids used as compatibility fallbacks.
STATUS_MEDIA_FILE_ID=
FEED_MEDIA_FILE_ID=
PLAY_MEDIA_FILE_ID=
WALK_MEDIA_FILE_ID=
TALK_MEDIA_FILE_ID=
SLEEP_MEDIA_FILE_ID=
CAT_ANGRY_SLEEP_MEDIA_FILE_ID=

# Rest meter: drops 1% every 5 minutes while the cat is awake.
SLEEP_DECAY_INTERVAL_MINUTES=5
SLEEP_DECAY_AMOUNT=1

# Optional chat/channel used for silent lazy asset uploads.
MEDIA_CACHE_CHAT_ID=
WAKE_CHECK_INTERVAL_MINUTES=1
