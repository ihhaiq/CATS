BOT_TOKEN=

# The active Rich/Guest runtime still uses JSON. Keep one Railway replica until
# the repository migration to PostgreSQL is completed.
STORAGE_BACKEND=json
DATABASE_URL=
JSON_DATA_FILE=data/catibot.json

# Empty means local long polling. Set the public Railway URL for webhooks.
WEBHOOK_BASE_URL=
WEBHOOK_PATH=/webhook
PORT=8080

ADMIN_IDS=
NOTIFICATION_INTERVAL_MINUTES=15

# Gameplay tuning
FEED_COOLDOWN_SECONDS=900
PLAY_COOLDOWN_SECONDS=900
WALK_COOLDOWN_SECONDS=14400
TALK_COOLDOWN_SECONDS=300
SLEEP_NEED_DROP_INTERVAL_MINUTES=5
SLEEP_NEED_DROP_PER_INTERVAL=1

# Optional Telegram file_ids. /dev can upload breed-specific media instead.
STATUS_MEDIA_FILE_ID=
FEED_MEDIA_FILE_ID=
PLAY_MEDIA_FILE_ID=
WALK_MEDIA_FILE_ID=
TALK_MEDIA_FILE_ID=
SLEEP_MEDIA_FILE_ID=
CAT_ANGRY_SLEEP_MEDIA_FILE_ID=
