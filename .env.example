BOT_TOKEN=

# PostgreSQL is the only runtime storage backend.
STORAGE_BACKEND=postgres
DATABASE_URL=

# Empty means local long polling. Set the public Railway URL for webhooks.
WEBHOOK_BASE_URL=
WEBHOOK_PATH=/webhook
# Optional override. On Railway the bot uses RAILWAY_PUBLIC_DOMAIN automatically.
ASSET_BASE_URL=
PORT=8080

ADMIN_IDS=
NOTIFICATION_INTERVAL_MINUTES=15

# Optional Telegram file_ids used only as compatibility fallbacks.
STATUS_MEDIA_FILE_ID=
FEED_MEDIA_FILE_ID=
PLAY_MEDIA_FILE_ID=
WALK_MEDIA_FILE_ID=
TALK_MEDIA_FILE_ID=
SLEEP_MEDIA_FILE_ID=
CAT_ANGRY_SLEEP_MEDIA_FILE_ID=

SLEEP_DECAY_INTERVAL_MINUTES=5
SLEEP_DECAY_AMOUNT=1

# Optional chat/channel used for silent lazy asset uploads.
MEDIA_CACHE_CHAT_ID=
WAKE_CHECK_INTERVAL_MINUTES=1
